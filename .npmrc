# Instalación resistente en redes corporativas.
#
# La auditoría y el mensaje de financiación hacen llamadas extra al registro al
# terminar de instalar. Detrás de un proxy que inspecciona TLS esas llamadas se
# cuelgan y npm muere con "Exit handler never called!", un fallo suyo que no
# dice nada de la causa. No aportan nada a la construcción de la imagen.
audit=false
fund=false

# Reintentos más pacientes para redes lentas o con inspección de tráfico.
fetch-retries=5
fetch-retry-maxtimeout=120000
fetch-timeout=300000
