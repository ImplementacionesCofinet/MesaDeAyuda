// Mesa de ayuda - Cofinet / Area de Datos y TI
// Modelo de datos del canal unico de requerimientos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Rol dentro de la mesa de ayuda.
enum Role {
  SOLICITANTE // Cualquier persona de un area que registra requerimientos.
  AGENTE // Integrante de Datos y TI que atiende y actualiza tickets.
  ADMIN // Administra areas, categorias, usuarios y acuerdos de tiempo.
}

/// Nivel de prioridad segun los criterios acordados con las areas.
enum Priority {
  ALTA // Operacion detenida o riesgo directo en despachos y cierres.
  MEDIA // Mejora necesaria que no bloquea la operacion diaria.
  BAJA // Optimizacion o desarrollo planificado sin urgencia.
}

/// Estado visible del requerimiento.
enum TicketStatus {
  NUEVO
  EN_ANALISIS
  EN_DESARROLLO
  EN_PRUEBAS
  EN_ESPERA
  ENTREGADO
  CERRADO
  CANCELADO
}

/// Quien origina el requerimiento.
enum TicketOrigin {
  AREA // Solicitud registrada por un area de la empresa.
  INTERNO // Proyecto o iniciativa propia de Datos y TI.
}

/// Tipo de entrada del historial del ticket.
enum EventType {
  CREACION
  CAMBIO_ESTADO
  CAMBIO_ETAPA
  ASIGNACION
  CAMBIO_PRIORIDAD
  CAMBIO_FECHA
  PENDIENTE
  COMENTARIO
  CIERRE
  REAPERTURA
  EDICION
}

/// Resultado del envio de una notificacion por correo.
enum EmailStatus {
  ENVIADO
  FALLIDO
  OMITIDO
}

/// Area de la empresa que solicita requerimientos.
model Area {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  tickets Ticket[]
}

/// Persona con acceso a la mesa de ayuda. Se crea/actualiza en cada inicio de
/// sesion con Microsoft Entra ID; no almacenamos contrasenas.
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  entraOid  String?   @unique // object id (oid) del usuario en Entra ID
  role      Role      @default(SOLICITANTE)
  areaId    String?
  active    Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  area Area? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  ticketsSolicitados Ticket[]        @relation("TicketSolicitante")
  ticketsAsignados   Ticket[]        @relation("TicketResponsable")
  ticketsPendientes  Ticket[]        @relation("TicketPendienteDe")
  comentarios        TicketComment[]
  eventos            TicketEvent[]

  @@index([areaId])
  @@index([role])
}

/// Tipo de requerimiento: OASIS, soporte tecnico, desarrollos, reportes, etc.
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Orden de presentacion en los formularios.
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
}

/// Acuerdo de tiempo por nivel de prioridad. Mientras `agreed` sea false la
/// interfaz muestra "Por acordar", tal como quedo en la propuesta.
model SlaPolicy {
  priority        Priority @id
  criterion       String
  responseHours   Int?
  resolutionHours Int?
  agreed          Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

/// Consecutivo anual para los codigos de ticket (MA-2026-0001).
model TicketCounter {
  year       Int @id
  lastNumber Int @default(0)
}

/// Requerimiento registrado en la mesa de ayuda.
model Ticket {
  id          String       @id @default(cuid())
  code        String       @unique
  title       String
  description String       @db.Text
  status      TicketStatus @default(NUEVO)
  priority    Priority     @default(MEDIA)
  origin      TicketOrigin @default(AREA)

  /// Punto exacto del flujo, en palabras del responsable.
  stage String?

  /// Actividad pendiente y de quien depende.
  pendingAction  String?
  pendingOwnerId String?

  categoryId  String
  areaId      String
  requesterId String
  assigneeId  String?

  requestedAt     DateTime  @default(now())
  dueDate         DateTime?
  firstResponseAt DateTime?
  startedAt       DateTime?
  deliveredAt     DateTime?
  closedAt        DateTime?
  closingNote     String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category @relation(fields: [categoryId], references: [id])
  area         Area     @relation(fields: [areaId], references: [id])
  requester    User     @relation("TicketSolicitante", fields: [requesterId], references: [id])
  assignee     User?    @relation("TicketResponsable", fields: [assigneeId], references: [id], onDelete: SetNull)
  pendingOwner User?    @relation("TicketPendienteDe", fields: [pendingOwnerId], references: [id], onDelete: SetNull)

  comments TicketComment[]
  events   TicketEvent[]
  emails   EmailLog[]

  @@index([status])
  @@index([assigneeId])
  @@index([requesterId])
  @@index([areaId])
  @@index([categoryId])
  @@index([priority])
  @@index([dueDate])
  @@index([createdAt])
}

/// Comentario en la conversacion del ticket.
model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  /// Nota interna de Datos y TI: no se muestra al area solicitante.
  internal  Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

/// Historial inmutable de cambios del ticket.
model TicketEvent {
  id        String    @id @default(cuid())
  ticketId  String
  actorId   String?
  type      EventType
  field     String?
  fromValue String?
  toValue   String?
  note      String?   @db.Text
  createdAt DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

/// Registro de las notificaciones por correo enviadas desde la mesa.
model EmailLog {
  id        String      @id @default(cuid())
  ticketId  String?
  to        String
  subject   String
  event     String
  status    EmailStatus
  error     String?     @db.Text
  createdAt DateTime    @default(now())

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
}
