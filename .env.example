# ─────────────────────────────────────────────────────────────────────────────
# Mesa de ayuda · Cofinet — configuración
# Copia este archivo como .env y completa los valores. No lo subas al repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos ──────────────────────────────────────────────────────────────
# Con docker compose, el usuario y la clave los toma de estas dos variables y
# DATABASE_URL se arma sola. Fuera de Docker, define DATABASE_URL a mano.
POSTGRES_USER=mesa
POSTGRES_PASSWORD=
POSTGRES_DB=mesadeayuda
# DATABASE_URL="postgresql://mesa:clave@localhost:5432/mesadeayuda?schema=public"

# Aplicación ─────────────────────────────────────────────────────────────────
# URL con la que las personas abren la mesa. Debe coincidir con la URI de
# redirección registrada en Entra ID.
APP_URL=https://mesadeayuda.cofinet.local
APP_PORT=3000
# Clave para firmar la cookie de sesión. Genérala con: openssl rand -base64 48
AUTH_SECRET=

# Microsoft Entra ID (SSO) ───────────────────────────────────────────────────
# Ver docs/entra-id.md para el paso a paso del registro de la aplicación.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Quién entra y con qué rol ──────────────────────────────────────────────────
# Correos separados por coma. Se aplican en cada inicio de sesión: quitar a
# alguien de aquí le baja el rol la próxima vez que entre.
ADMIN_EMAILS=
AGENT_EMAILS=
# Dominios autorizados. Vacío = cualquier cuenta del tenant.
ALLOWED_EMAIL_DOMAINS=cofinet.com.au
# Crear el usuario automáticamente en su primer inicio de sesión.
AUTH_AUTO_PROVISION=true

# Notificaciones por correo ──────────────────────────────────────────────────
MAIL_ENABLED=true
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mesadeayuda@cofinet.com.au
SMTP_PASSWORD=
SMTP_FROM=Mesa de ayuda Cofinet <mesadeayuda@cofinet.com.au>

# Jornada laboral (para calcular la fecha estimada de cierre) ────────────────
# Desfase respecto a UTC en minutos: -300 = UTC-5 (Colombia).
APP_UTC_OFFSET_MINUTES=-300
APP_WORKDAY_START_HOUR=8
APP_WORKDAY_END_HOUR=17
APP_DISPLAY_TIMEZONE=America/Bogota

# Arranque ───────────────────────────────────────────────────────────────────
# Carga áreas, categorías y niveles de prioridad al iniciar. Es idempotente.
SEED_ON_START=true
# Requerimientos de ejemplo para mostrar la mesa antes de abrirla. Solo pruebas.
SEED_DEMO=false

# Desarrollo local ───────────────────────────────────────────────────────────
# Permite entrar sin Entra ID eligiendo un usuario de la lista. Nunca se activa
# con NODE_ENV=production.
AUTH_DEV_MODE=false
